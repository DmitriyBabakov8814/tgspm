# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ────────────────────────────────────────────────────
venv/
env/
.venv/
ENV/

# ── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.cursor/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Secrets & local config (NEVER commit) ───────────────────────────────────
.env
.env.*
!.env.example
config.local.json
config.json
secrets.json
bootstrap.local.json
data/bootstrap.local.json
**/tokens.txt
**/api_keys.txt

# ── Telegram sessions & personal data ───────────────────────────────────────
*.session
*.session-journal
sessions/
data/tg_sender.db
data/tg_sender.db-*
data/app.log
data/*.db
data/*.sqlite3

# Keep code in data/ package, ignore runtime files only
data/*
!data/__init__.py
!data/database.py
!data/.gitkeep

# ── PyInstaller / packaging ─────────────────────────────────────────────────
*.spec

# ── Testing / tooling ─────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
tmp/
temp/

# ── User-generated exports ────────────────────────────────────────────────────
exports/
backups/
downloads/
